{
  "motion": {
    "travel": {
      "$type": "number",
      "$value": 0
    },
    "toggle": {
      "move-duration": {
        "$type": "duration",
        "$value": "{duration.instant}"
      }
    },
    "enter-sm": {
      "distance": {
        "$type": "dimension",
        "$value": "0px"
      },
      "scale": {
        "$type": "number",
        "$value": 1
      },
      "move-easing": {
        "$type": "cubicBezier",
        "$value": "{motion.enter-sm.easing}"
      }
    },
    "exit-sm": {
      "distance": {
        "$type": "dimension",
        "$value": "0px"
      },
      "scale": {
        "$type": "number",
        "$value": 1
      },
      "move-easing": {
        "$type": "cubicBezier",
        "$value": "{motion.exit-sm.easing}"
      }
    },
    "enter-md": {
      "distance": {
        "$type": "dimension",
        "$value": "0px"
      },
      "scale": {
        "$type": "number",
        "$value": 1
      },
      "move-easing": {
        "$type": "cubicBezier",
        "$value": "{motion.enter-md.easing}"
      }
    },
    "exit-md": {
      "distance": {
        "$type": "dimension",
        "$value": "0px"
      },
      "scale": {
        "$type": "number",
        "$value": 1
      },
      "move-easing": {
        "$type": "cubicBezier",
        "$value": "{motion.exit-md.easing}"
      }
    },
    "enter-lg": {
      "distance": {
        "$type": "dimension",
        "$value": "0px"
      },
      "scale": {
        "$type": "number",
        "$value": 1
      },
      "move-easing": {
        "$type": "cubicBezier",
        "$value": "{motion.enter-lg.easing}"
      }
    },
    "exit-lg": {
      "distance": {
        "$type": "dimension",
        "$value": "0px"
      },
      "scale": {
        "$type": "number",
        "$value": 1
      },
      "move-easing": {
        "$type": "cubicBezier",
        "$value": "{motion.exit-lg.easing}"
      }
    },
    "expand": {
      "duration": {
        "$type": "duration",
        "$value": "{duration.instant}"
      },
      "move-duration": {
        "$type": "duration",
        "$value": "{duration.instant}"
      }
    },
    "move": {
      "duration": {
        "$type": "duration",
        "$value": "{duration.instant}"
      },
      "move-duration": {
        "$type": "duration",
        "$value": "{duration.instant}"
      }
    },
    "loop": {
      "duration": {
        "$type": "dimension",
        "$value": "calc({duration.800} * 2)"
      }
    },
    "attention": {
      "duration": {
        "$type": "duration",
        "$value": "{duration.instant}"
      },
      "move-duration": {
        "$type": "duration",
        "$value": "{duration.instant}"
      }
    }
  }
}
