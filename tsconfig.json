{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@formtrieb/tokens-recipe/editor": [
        "./src/editor/index.ts"
      ],
      "@formtrieb/tokens-recipe": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "app/**/*"
  ]
}
